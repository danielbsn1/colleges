#include <iostream>
using namespace std;

int main()
{
    int n1, n2;

    n1 = 0;
    n2 = 10;

    cout << "Valor de n1: " << n1 << endl;

    n1 = n1 + 1; // Incremento
    cout << "Valor de n1: " << n1 << endl;

    n2 = n2 - 1; // Decremento
    cout << "Valor de n2: " << n2 << endl;

    return 0;
}